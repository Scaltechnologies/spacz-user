# SPACZ gateway URL (the only API configuration).
# Leave empty in development: the app then calls the gateway on the PC running Metro
# (http://<that PC's current Wi-Fi IP>:EXPO_PUBLIC_API_PORT), so a changed DHCP address needs no edit.
# Set it explicitly for production/preview builds or tunnel mode, e.g. http://192.168.0.107:8080
# After any change restart Metro with a cleared cache: npx expo start -c
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_PORT=8080
